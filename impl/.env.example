# railway_core 的全部設定。每一項都有可直接使用的預設值，通常不需要改。
#
# 【注意】新增環境變數時，必須同步更新 src/railway_core/settings.py 的 ENV_VARS；
# scripts/check_assets.py 會比對這兩者，漏掉會讓 CI 失敗。
#
# 【隱私】這個檔案裡不要放真實姓名、校名、醫院名或任何可識別資訊。
# 個案化資料請寫在附錄D 的私人檔（*.private.md，已排除於版控之外）。

# 記錄與設定的存放目錄
RAILWAY_DATA_DIR=data

# 列印資產（SVG）的輸出目錄
RAILWAY_OUT_DIR=out

# 個案代號。請用簡短代號（例如 J），不要用真名。
RAILWAY_PROFILE_CODE=J

# 角色稱號（第 15 章）。家庭與學校請使用同一個。
RAILWAY_ROLE_TITLE=維修長

# 固著主題（第 10 章）。教材的外殼會用它。
RAILWAY_FIXATION_TOPIC=火車
